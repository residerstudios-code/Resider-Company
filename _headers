# Cabecalhos de seguranca aplicados pelo Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache das imagens (vale no Cloudflare Pages; o GitHub Pages ignora este arquivo).
# 1 dia: se trocar uma imagem sem mudar o nome, quem ja visitou ve a nova em ate 1 dia.
/img/*
  Cache-Control: public, max-age=86400
